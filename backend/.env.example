# Merge these mail settings into backend/.env; keep existing database/admin settings.
SMTP_HOST=mail.nlptec.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=webmailer.nlptec.com
SMTP_APP_PASSWORD=<client-provided SMTP password>
ADMIN_EMAIL=sales@tariustechnology.com
# Required: replace with the sender email explicitly authorized by the provider.
# The SMTP username is not a sender email address.
MAIL_FROM=
MAIL_SUBJECT="Enquiry from NLPTech Website"
